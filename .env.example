########################################
# Wavlo – Environment Configuration
# Copy this file to `.env` and fill in
# your real secrets. NEVER commit `.env`.
########################################

# Gemini API key used as the default when the user
# has not set a personal key in Settings.
GEMINI_API_KEY=your_gemini_api_key_here

# JioSaavn API base URL (your deployed saavn.dev proxy)
# Example: https://your-jiosaavn-api.vercel.app/api
JIOSAAVN_BASE_URL=https://your-jiosaavn-api.vercel.app/api

# Firebase / other backend keys (optional)
FIREBASE_API_KEY=your_firebase_key_here
BACKEND_BASE_URL=https://your-backend-url-here

# Add any other secrets here, for example:
# APP_CENTER_SECRET=...
# SENTRY_DSN=...

